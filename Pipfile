[packages]
plette = { path = '.', extras = ['validation'], editable = true }

[dev-packages]
pytest = '*'
pytest-cov = '*'
pytest-xdist = '*'
sphinx = '*'
sphinx-rtd-theme = '*'
towncrier = '*'
twine = '*'
wheel = '*'

[scripts]
build = 'python -m build'
changelog = 'towncrier'
docs = 'sphinx-build -b html docs docs/_build'
draft = 'towncrier --draft'
tests = 'pytest -v tests'
